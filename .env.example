# Copy to .env (ignored by git) and adjust. Real environment variables override this file.
# run.py and the scripts read it; tests never do.

# fake = built-in sample data (any PC); desktop = real QuickBooks Desktop (server only, PLAN step 3)
JCT_QB_MODE=fake

# Folder holding jobs.db. On the server keep it OUTSIDE the code folder, e.g. C:\AppData\JobCostTracker
JCT_DATA_DIR=./data

# Where scripts.backup_db writes copies (default: <data dir>\backups) and how many to keep
# JCT_BACKUP_DIR=D:\Backups\JobCostTracker
JCT_BACKUP_KEEP=30

# Minutes between automatic QuickBooks syncs
JCT_SYNC_MINUTES=30

# Web server. 0.0.0.0 = reachable from the office LAN; 127.0.0.1 = this PC only
JCT_HOST=0.0.0.0
JCT_PORT=8000
